
# Copie este arquivo para .env. O .env nunca vai para o git.

# --- Banco de dados ---
# Escolha um caminho: deixe uma linha DATABASE_URL ativa
# e a outra comentada com #.

# Caminho 1 - SQLite: banco de dados local.
DATABASE_URL=sqlite:///./todo_list.db

# Caminho 2 - PostgreSQL no Render:
# DATABASE_URL=postgresql+psycopg://USUARIO:SENHA@HOST:5432/BANCO?sslmode=require
